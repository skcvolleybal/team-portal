{
    "name": "jonathanneuteboom/team-portal",
    "description": "Team-portal van de volleybalvereniging SKC Leiden",
    "authors": [
        {
            "name": "J.I. Neuteboom",
            "email": "jonathan.neuteboom@gmail.com"
        }
    ],
    "require": {
        "kigkonsult/icalcreator": "^2.41",
        "phpmailer/phpmailer": "^7.1",
        "simplepie/simplepie": "^1.9",
        "slim/slim": "^4.15",
        "guzzlehttp/psr7": "^2.7",
        "http-interop/http-factory-guzzle": "^1.2",
        "php-di/php-di": "^7.1",
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.7",
        "phpoffice/phpspreadsheet": "^5.0"
    },
    "config": {
        "platform": {
            "php": "8.5"
        }
    },
    "autoload": {
        "classmap": [
            "UseCases",
            "Entities",
            "Gateways",
            "Common",
            "TeamPortalErrorHandler.php",
            "RouteObjects",
            "Tests"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
